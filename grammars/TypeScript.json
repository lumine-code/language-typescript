{
  "name": "TypeScript",
  "scopeName": "source.ts",
  "type": "tree-sitter",
  "parser": "tree-sitter-typescript/typescript",
  "fileTypes": ["ts", "cts", "mts"],
  "injectionNames": ["typescript", "ts"],
  "comments": {
    "start": "// "
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-typescript/typescript#v0.23.2",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "languageSegment": "ts",
    "grammar": "typescript.wasm",
    "highlightsQuery": "typescript-shared-highlights.scm",
    "indentsQuery": "typescript-shared-indents.scm",
    "foldsQuery": "typescript-shared-folds.scm",
    "tagsQuery": "typescript-shared-tags.scm",
    "injectionsQuery": "typescript-injections.scm",
    "contentEditPolicies": {
      "content-words": "../lib/content-edit-policy.js"
    }
  },
  "firstLineRegex": [
    "^#![ \\t]*(?:(?:[^ \\t\\r\\n]*/)?env[ \\t]+(?:-S[ \\t]+)?(?:[^ \\t\\r\\n]*/)?|(?:[^ \\t\\r\\n]*/)?)(?:ts-node(?:-esm)?|tsx)(?=[ \\t\\r\\n]|$)"
  ]
}

{
  ".source.tsx": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      },
      "nonWordCharacters": "/\\()\"':,.;<>~!@%^&*|+=[]{}`?-…"
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''", "``"]
    }
  },
  ".meta.tag.ts.tsx, .meta.block.jsx.ts.tsx": {
    "editor": {
      "commentStart": "{/* ",
      "commentEnd": " */}",
      "commentDelimiters": {
        "block": ["{/*", "*/}"]
      }
    }
  },
  ".meta.embedded.code.ts.tsx": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": {
          "start": "/*",
          "end": "*/"
        }
      }
    }
  }
}

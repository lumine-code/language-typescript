{
  ".source.tsx": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      }
    }
  },
  ".meta.tag.tsx, .meta.block.jsx.ts.tsx": {
    "editor": {
      "commentStart": "{/* ",
      "commentEnd": " */}",
      "commentDelimiters": {
        "block": ["{/*", "*/}"]
      }
    }
  },
  ".meta.tag.tsx .meta.block.ts.tsx": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": {
          "start": "/*",
          "end": "*/"
        }
      }
    }
  }
}

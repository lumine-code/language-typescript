{
  ".source.ts": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      },
      "nonWordCharacters": "/\\()\"':,.;<>~!@%^&*|+=[]{}`?-…"
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''", "``"]
    }
  }
}
